# Valores de producción: Forge copia este archivo y llena lo que falta. Para
# desarrollar con Sail, ver las notas "local:".

APP_NAME=Tarjetero
APP_ENV=production                      # local: local
# php artisan key:generate --show. Guárdala en un gestor de contraseñas: el
# límite de las tarjetas se cifra con ella y sin ella no se recupera, ni
# desde un respaldo.
APP_KEY=
APP_DEBUG=false
APP_URL=https://tarjetero.halivert.dev  # local: http://localhost
# Nombre en la pestaña del navegador; se lee al compilar (npm run build)
VITE_APP_NAME="${APP_NAME}"
# Solo si hay un proxy delante (Cloudflare, balanceador), con sus rangos de IP
#TRUSTED_PROXIES=

# Cerrado durante la beta: las cuentas se crean con php artisan user:invite
REGISTRATION=false

# Identificador de las passkeys, aparte de APP_KEY para que no cambie al
# rotarla (openssl rand -hex 32)
PASSKEYS_USER_HANDLE_SECRET=

DB_CONNECTION=mysql                     # local: mariadb (Sail)
DB_HOST=127.0.0.1                       # local: mariadb
DB_PORT=3306
DB_DATABASE=tarjetero
DB_USERNAME=tarjetero
DB_PASSWORD=

REDIS_HOST=127.0.0.1                    # local: redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
# Minutos de inactividad antes de cerrar la sesión; su contenido va cifrado
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# La cookie solo viaja por HTTPS
SESSION_SECURE_COOKIE=true              # local: false

# Vigencia de los tokens de la API, en minutos (30 días)
SANCTUM_EXPIRATION=43200
#CORS_ALLOWED_ORIGINS=https://example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning                       # local: debug

# Resend por SMTP (ver docs/deploy.md)
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com               # local: mailpit
MAIL_PORT=587                           # local: 1025
MAIL_ENCRYPTION=tls                     # local: null
MAIL_USERNAME=resend
MAIL_PASSWORD=                          # API key de Resend (re_…)
MAIL_FROM_ADDRESS=no-reply@tarjetero.halivert.dev
MAIL_FROM_NAME="${APP_NAME}"

# A quién avisar de intentos sospechosos fuera de lo normal y de respaldos
# que fallen
SECURITY_ALERT_EMAIL=

# Aviso de privacidad (/privacidad): tu nombre y el correo para solicitudes
PRIVACY_OWNER=
PRIVACY_EMAIL=

# Respaldos diarios (php artisan db:backup, lo corre el scheduler)
BACKUP_PATH=/home/forge/backups         # local: vacío (storage/app/backups)
BACKUP_KEEP_DAYS=30
