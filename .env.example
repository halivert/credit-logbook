APP_NAME="Bitácora de crédito"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=localhost
APP_URL=http://${APP_DOMAIN}
# Proxies de confianza, solo si hay uno delante (Cloudflare, balanceador)
#TRUSTED_PROXIES=*

REGISTRATION=false

# Sesión: minutos de inactividad antes de cerrarla. En producción la cookie
# solo viaja por HTTPS (SESSION_SECURE_COOKIE) y su contenido va cifrado.
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
#SESSION_SECURE_COOKIE=true

# Vigencia de los tokens de la API, en minutos (30 días)
SANCTUM_EXPIRATION=43200
#CORS_ALLOWED_ORIGINS=https://example.com

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=credit_logbook
DB_USERNAME=
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

VITE_APP_NAME=${APP_NAME}
